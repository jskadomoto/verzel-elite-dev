{
  "name": "verzel-elite-dev-api",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc && cp -r src/db/migrations dist/db/migrations && cp src/catalog/fixtures.json dist/catalog/fixtures.json",
    "start": "node dist/server.js",
    "seed": "tsx --env-file=.env src/db/seed.ts",
    "seed:built": "node dist/db/seed.js",
    "test": "tsx --env-file=.env --test tests/*.test.ts",
    "test:repeat": "for i in 1 2 3 4 5; do echo \"execução $i\"; tsx --env-file=.env --test tests/*.test.ts || exit 1; done"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
